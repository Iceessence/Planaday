{
  "name": "planaday-desktop",
  "version": "4.2.0",
  "description": "Planaday Native Desktop App — Standalone Offline Life Planner, Scanner, PDF Studio & Docker Sync",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:installer": "electron-builder --win nsis portable --x64",
    "dist:win:msix": "electron-builder --win appx --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.dayplana.desktop",
    "productName": "Planaday",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "Open PDF in Planaday PDF Studio",
        "role": "Editor"
      },
      {
        "ext": "dmtheme",
        "name": "Planaday Theme Pack",
        "description": "Planaday Custom Theme Pack",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "identityName": "Planaday.Desktop",
      "publisherDisplayName": "Planaday",
      "applicationId": "PlanadayDesktop",
      "displayName": "Planaday"
    }
  },
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "^26.0.12"
  }
}
